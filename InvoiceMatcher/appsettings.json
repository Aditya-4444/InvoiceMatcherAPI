{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Invoices": "Data Source=invoices.db;Default Timeout=30"
  },
  "InvoiceProcessing": {
    "InboxPath": "../data/inbox",
    "ArchivePath": "../data/archive",
    "FailedPath": "../data/failed",
    "PosCsvPath": "../data/pos.csv",
    "QueueCapacity": 100,
    "MaxAttempts": 3,
    "RetryBackoffMilliseconds": 250,
    "FileReadyAttempts": 10,
    "FileReadyDelayMilliseconds": 250
  }
}
